# ============================================
# FEIRINHA EXPRESS - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha os valores

# ==================== DATABASE ====================
# Neon PostgreSQL Connection String
# Obtenha em: https://console.neon.tech
DATABASE_URL="postgresql://username:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/feirinha_db?sslmode=require"

# ==================== AUTH ====================
# Gere um secret seguro com: openssl rand -base64 32
JWT_SECRET="SUA_CHAVE_SECRETA_AQUI_MINIMO_32_CARACTERES"

# ==================== REDIS (Opcional) ====================
# Se usar cache Redis (opcional para deploy inicial)
# REDIS_URL="redis://default:password@host:port"

# ==================== SERVER ====================
PORT=3001
NODE_ENV=production

# ==================== CORS ====================
# Domínios permitidos (adicione seu domínio depois)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://feirinha-express.vercel.app"
