{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run db:migrate:prod && npm run build",
    "startCommand": "npm run start"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthCheck": {
    "path": "/api/health",
    "periodSeconds": 30,
    "timeoutSeconds": 10,
    "failureThreshold": 3
  }
}
