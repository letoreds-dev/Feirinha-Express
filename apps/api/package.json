{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx --tsconfig tsconfig.json src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "deploy": "npm run db:migrate:prod && npm run build && npm run start"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^9.0.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "zod": "^3.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
